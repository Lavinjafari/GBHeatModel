# GBHeatModel — version-control policy
# Track the model source, notebooks, configurations and all redistributable
# input datasets under data/. Only generated results and external raw ERA5
# archives are excluded.

# Generated results (keep locally; regenerate from inputs)
/data/outputs/
/outputs/
/Figures/

# Raw ERA5/Atlite weather archives hosted externally on Zenodo.
# Keep this rule ONLY if data/Atlite/ contains the downloadable raw data.
/data/Atlite/

# Python build/runtime files
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Notebook runtime files
.ipynb_checkpoints/

# Virtual environments and local secrets
.venv/
venv/
GBheat/
.env
.env.*
!.env.example

# Local IDE and OS metadata
.vscode/
.idea/
.DS_Store
Thumbs.db


# ============================================================
# GBHeat — Externally hosted model inputs
# Downloaded separately from Zenodo
# ============================================================

/data/Atlite/
/data/air_temp/
/data/heat_demand_profiles_patterns/

# ============================================================
# Generated model outputs — always local
# ============================================================

/data/outputs/

# Deliberately do NOT ignore data/FES_Spatial_Heat_Model/
# data/LAs_shapefile_2021/

# data/spatial_operators/ or standalone input files.
